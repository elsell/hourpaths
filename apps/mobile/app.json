{
  "expo": {
    "name": "HourPaths",
    "slug": "hourpaths",
    "version": "1.0.0",
    "scheme": "hourpaths",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b145a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [],
          "enablePushNotifications": false,
          "bundleIdentifier": "com.hourpaths.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.hourpaths.mobile"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.hourpaths.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.hourpaths.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b145a"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#141414",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#141414",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
