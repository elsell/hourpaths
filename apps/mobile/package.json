{
  "name": "@hourpaths/mobile",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "mobile:doctor": "expo-doctor",
    "mobile:compat": "expo install --check && node ../../scripts/validate-expo-native-set.mjs",
    "mobile:export": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "mobile:prebuild": "node ../../scripts/validate-mobile-config.mjs && expo prebuild --clean --no-install",
    "mobile:build:android": "pnpm mobile:prebuild && cd android && ./gradlew assembleDebug",
    "mobile:build:ios": "pnpm mobile:prebuild && bundle install --jobs 4 --retry 3 && cd ios && bundle exec pod install && cd ../../.. && ./scripts/build-ios-simulator.sh",
    "mobile:dev:android": "expo run:android",
    "mobile:dev:ios": "expo run:ios",
    "mobile:release:android": "node ../../scripts/validate-mobile-release-env.mjs && node ../../scripts/run-eas.mjs android",
    "mobile:release:ios": "node ../../scripts/validate-mobile-release-env.mjs && node ../../scripts/run-eas.mjs ios",
    "build": "pnpm mobile:export",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts ../../apps/web/src/lib/config.test.ts && node --test ../../scripts/run-eas.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@expo/ui": "57.0.19",
    "@hourpaths/api-client": "workspace:*",
    "@hourpaths/client-core": "workspace:*",
    "@hourpaths/i18n": "workspace:*",
    "expo": "57.0.24",
    "expo-auth-session": "57.0.12",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.10",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.20",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.23",
    "expo-web-browser": "57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/react": "19.3.0",
    "expo-doctor": "1.20.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
